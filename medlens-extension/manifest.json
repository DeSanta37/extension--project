{
  "manifest_version": 3,
  "name": "MedLens",
  "version": "0.2.9",
  "description": "AI-адаптация медицинских текстов",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://gigachat.devices.sberbank.ru/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "MedLens",
    "default_icon": {
      "16": "MedLens.svg",
      "48": "MedLens.svg",
      "128": "MedLens.svg"
    }
  },
  "icons": {
    "16": "MedLens.svg",
    "48": "MedLens.svg",
    "128": "MedLens.svg"
  }
}
